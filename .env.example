# Copy to .env and fill in real values. NEVER commit .env (it is gitignored).

# Express API port
PORT=3001

# OpenCode AI server sidecar (opencode serve). The backend routes all LLM calls here.
# Auth is inherited from ~/.local/share/opencode/auth.json (run `opencode auth login`
# and select the `opencode-go` provider). No AI API key is needed in this file.
OPENCODE_SERVER_URL=http://127.0.0.1:4096

# Model refs on the opencode-go provider (auth via `opencode auth login` —
# your OpenCode Go API key lives in ~/.local/share/opencode/auth.json).
OPENCODE_PRO_MODEL=muse-spark-1.3-contributor
OPENCODE_FLASH_MODEL=muse-spark-1.3-contributor

# --- Revamp P0 ---
# SQLite lives under DATA_DIR (./data/crumbbase.db + pages mirror).
DATA_DIR=./data

# Transcript capture: auto = try yt-dlp, fall back to pasted text;
# yt-dlp = fail loudly when fetch fails; paste = skip fetching entirely.
TRANSCRIPT_PROVIDER=auto

# Shared token gating the Settings API + page (required for /api/settings*).
# The UI asks for it once per browser tab (sessionStorage). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SETTINGS_TOKEN=

# Optional: Netscape cookies file so yt-dlp passes YouTube's bot check.
# Export from a logged-in browser (e.g. "Get cookies.txt LOCALLY" for
# youtube.com), save under ./data/ (gitignored, never committed), chmod 600.
# Empty = unauthenticated fetch (may hit "Sign in to confirm you're not a bot").
YTDLP_COOKIES=

# GitHub backup (P1 job pushes ./data mirror; P0 only reports health).
GITHUB_BACKUP_ENABLED=false
GITHUB_BACKUP_REPO=
GITHUB_BACKUP_BRANCH=main
